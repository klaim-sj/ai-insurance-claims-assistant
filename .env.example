# Salin ke .env lalu isi. JANGAN commit file .env.
# Semua nilai di bawah adalah placeholder.

# development | production | test
APP_ENV=development
APP_ADDR=:8080

# Wajib minimal 32 karakter saat APP_ENV=production (aplikasi gagal start jika
# kosong/pendek). Di development, bila kosong dipakai nilai acak + warning.
# Contoh membuat nilai: openssl rand -base64 48
APP_SECRET=<APP_SECRET_MIN_32_KARAKTER>

# Set true hanya bila aplikasi berada di belakang reverse proxy tepercaya.
TRUST_PROXY=false

DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/claims_dev?sslmode=disable
TEST_DATABASE_URL=postgres://<USER>:<PASSWORD>@localhost:5432/claims_test?sslmode=disable

# Password akun demo yang dibuat oleh `make seed` (minimal 12 karakter).
DEMO_PASSWORD=<DEMO_PASSWORD>
